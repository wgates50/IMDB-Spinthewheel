# Both keys are optional. Without them the wheel, the type filter, the genre
# filter and the IMDb rating filter all still work from your watchlist export.
#
# OMDb — Metascore, certificate, awards, Rotten Tomatoes score, full plot.
# Free key (1,000 requests/day): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# TMDB — cast, reviews, trailers and where-to-watch.
# Free key: https://www.themoviedb.org/settings/api
# Set either one. The v4 read access token is preferred when both are present.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
